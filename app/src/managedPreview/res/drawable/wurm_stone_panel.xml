<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:startColor="#F21C251F" android:endColor="#F2141C17" android:angle="270" />
            <stroke android:width="1dp" android:color="#998C7955" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#304C5747" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
