<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:startColor="#3A4035" android:endColor="#212A24" android:angle="270" />
            <stroke android:width="1dp" android:color="#8C7955" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#404B493B" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:width="3dp" android:height="3dp" android:gravity="left|center_vertical" android:left="8dp">
        <shape android:shape="oval"><solid android:color="#B5A174" /></shape>
    </item>
    <item android:width="3dp" android:height="3dp" android:gravity="right|center_vertical" android:right="8dp">
        <shape android:shape="oval"><solid android:color="#B5A174" /></shape>
    </item>
</layer-list>
