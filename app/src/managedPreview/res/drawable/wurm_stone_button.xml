<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40E5C47D">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#242923" />
                    <stroke android:width="1dp" android:color="#59594A" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item android:state_selected="true" android:drawable="@drawable/wurm_stone_selected" />
            <item android:state_focused="true" android:drawable="@drawable/wurm_stone_selected" />
            <item android:drawable="@drawable/wurm_stone_slab" />
        </selector>
    </item>
</ripple>
